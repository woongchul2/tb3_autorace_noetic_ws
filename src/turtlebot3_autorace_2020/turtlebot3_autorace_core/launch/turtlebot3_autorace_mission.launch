<launch>
   <arg name="parking_obstacle_x" default="random"/>
   <arg name="initial_traffic_state" default="1"/>
   <node pkg="turtlebot3_autorace_core" type="core_node_mission" name="core_node_mission" output="screen">
      <param name="parking_obstacle_x" value="$(arg parking_obstacle_x)"/>
      <param name="initial_traffic_state" value="$(arg initial_traffic_state)"/>
   </node>
</launch>
