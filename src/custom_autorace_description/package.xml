<?xml version="1.0"?>
<package format="2">
  <name>custom_autorace_description</name>
  <version>0.1.0</version>
  <description>Parameterized URDF and Gazebo model for a custom TurtleBot3 AutoRace robot.</description>
  <maintainer email="user@example.com">AutoRace Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>gazebo_msgs</depend>
  <depend>gazebo_plugins</depend>
  <depend>gazebo_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>robot_state_publisher</depend>
  <depend>robot_localization</depend>
  <depend>rospy</depend>
  <depend>std_srvs</depend>
  <depend>urdf</depend>
  <depend>visualization_msgs</depend>
  <depend>xacro</depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
</package>
