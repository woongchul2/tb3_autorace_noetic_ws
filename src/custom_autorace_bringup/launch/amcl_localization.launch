<launch>
  <arg name="map_file"
       default="$(find custom_autorace_bringup)/maps/autorace_gazebo.yaml"/>
  <arg name="scan_topic" default="/scan_mid360_raw"/>
  <arg name="initial_pose_x" default="0.8"/>
  <arg name="initial_pose_y" default="-1.747"/>
  <arg name="initial_pose_a" default="0.0"/>
  <arg name="amcl_config"
       default="$(find custom_autorace_bringup)/config/amcl_gazebo.yaml"/>

  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg map_file)" output="screen"/>

  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <rosparam command="load" file="$(arg amcl_config)"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
  </node>

  <!-- AMCL otherwise waits for update_min_d motion before its first scan
       correction, leaving map -> odom unavailable while the start light is red. -->
  <node pkg="custom_autorace_bringup" type="amcl_startup_update.py"
        name="amcl_startup_update" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)"/>
  </node>
</launch>
